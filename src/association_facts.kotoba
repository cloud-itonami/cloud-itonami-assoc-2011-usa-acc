(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [association :string] :bool
  ;; `:bool`, not `:i64`. `string=?` returns a boolean and `bool is a type, not
  ;; a number` is permanent in this language -- the `:i64` here was written
  ;; against a compiler old enough that predicates reduced to 1/0, and it stops
  ;; the module compiling for ANY target on a current one:
  ;; `expression type mismatch: expected i64, got bool`.
  (string=? association "acc"))
(defn entry-count [association :string] :i64
  (if (association-covered? association) 2 0))
(defn valid-entry? [association :string index :i64] :bool
  (if (association-covered? association)
    (if (= index 0) true (if (= index 1) true false)) false))

(defn entry-field [association :string index :i64 field :string]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (cond
        (string=? field "id") (option-some-of [:option :string] "acc.our-150-years-history")
        (string=? field "title") (option-some-of [:option :string] "Our 150 Years History")
        (string=? field "association") (option-some-of [:option :string] "acc")
        (string=? field "isic") (option-some-of [:option :string] "2011")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "governance-program")
        (string=? field "url") (option-some-of [:option :string] "https://www.americanchemistry.com/about-acc/our-150-years-history")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1872")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string]))
      (cond
        (string=? field "id") (option-some-of [:option :string] "acc.responsible-care-overview")
        (string=? field "title") (option-some-of [:option :string] "Responsible Care Overview")
        (string=? field "association") (option-some-of [:option :string] "acc")
        (string=? field "isic") (option-some-of [:option :string] "2011")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? field "url") (option-some-of [:option :string] "https://www.americanchemistry.com/driving-safety-sustainability/responsible-care-driving-safety-sustainability/resources/responsible-care-overview")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1988")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [association :string index :i64] :i64
  (if (valid-entry? association index) (if (= index 0) 1 2) 0))
(defn topic [association :string index :i64 topic-index :i64]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (if (= topic-index 0) (option-some-of [:option :string] "governance")
          (option-none-of [:option :string]))
      (if (= topic-index 0) (option-some-of [:option :string] "safety")
          (if (= topic-index 1) (option-some-of [:option :string] "environment")
              (option-none-of [:option :string]))))
    (option-none-of [:option :string])))

(defn by-topic-count [association :string candidate :string] :i64
  (if (association-covered? association)
    (if (string=? candidate "governance") 1
        (if (string=? candidate "safety") 1
            (if (string=? candidate "environment") 1 0))) 0))
(defn by-topic-id [association :string candidate :string index :i64]
  [:option :string]
  (if (association-covered? association)
    (if (= index 0)
      (if (string=? candidate "governance") (entry-field association 0 "id")
          (if (string=? candidate "safety") (entry-field association 1 "id")
              (if (string=? candidate "environment") (entry-field association 1 "id")
                  (option-none-of [:option :string]))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn coverage-note [association :string] [:option :string]
  (if (association-covered? association)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-2011-usa-acc Wave 0 (ADR-2607141700): 2 acc entries seeded with an official americanchemistry.com citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))
(defn main [] :i64 0)
